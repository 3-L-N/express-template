{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Development server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "nodemon",
      "runtimeArgs": ["--env-file=.env", "config/index.mjs"],
      "cwd": "${workspaceFolder}/website",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
