{
  "name": "express-template",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "start": "cd website && node --env-file=.env index.mjs",
    "build": "echo \"No build step required for now\"",
    "dev": "cd website && nodemon --env-file=.env index.mjs",
    "test": "cd website && node --test --experimental-test-coverage",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:lint": "eslint .",
    "check": "npm run check:format && npm run check:lint"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
