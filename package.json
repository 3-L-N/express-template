{
  "name": "express-template",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "start": "cd website && node --env-file=.env config/index.mjs",
    "build": "echo \"No build step required for now\"",
    "dev": "cd website && nodemon --env-file=.env config/index.mjs",
    "test": "cd website && node --test --experimental-test-coverage --test-coverage-include-all  test/unit/* test/intergration/*",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.5.1",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^7.5.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": "eslint --fix",
    "*.{json,md,css}": "prettier --write"
  }
}
