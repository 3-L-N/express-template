{
  "name": "express-template",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start": "node --env-file=.env website/config/server.mjs",
    "dev": "nodemon --env-file=.env website/config/server.mjs",
    "test": "node --test --experimental-test-coverage"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  }
}